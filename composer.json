{
    "name": "wdpai/my-app",
    "description": "Leitner system flashcard repetition web application (WDPAI)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "App\\Controller\\": [
                "src/controllers/",
                "src/Controller/"
            ],
            "App\\Core\\": [
                "src/core/",
                "src/Core/"
            ],
            "App\\Service\\": [
                "src/services/",
                "src/Service/"
            ],
            "App\\Repository\\": [
                "src/repositories/",
                "src/Repository/"
            ],
            "App\\Model\\": [
                "src/models/",
                "src/Model/"
            ],
            "App\\Exception\\": [
                "src/exceptions/",
                "src/Exception/"
            ]
        },
        "classmap": [
            "Routing.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
