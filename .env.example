# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Europe/Warsaw
APP_PORT=8080

# Database (PHP PDO connection)
DB_HOST=db
DB_PORT=5432
DB_NAME=wdpai
DB_USER=wdpai
DB_PASSWORD=example_db_password_change_me

# PostgreSQL Container
POSTGRES_DB=wdpai
POSTGRES_USER=wdpai
POSTGRES_PASSWORD=example_db_password_change_me
POSTGRES_PORT=5433

# SMTP / Mailer (Mailpit in local development)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=
SMTP_FROM_EMAIL=noreply@wdpai.local
SMTP_FROM_NAME="WDPAI Flashcards"
MAILPIT_PORT=8025

# pgAdmin
PGADMIN_CONTAINER_NAME=pg-admin
PGADMIN_DEFAULT_EMAIL=admin@wdpai.local
PGADMIN_DEFAULT_PASSWORD=example_pgadmin_password_change_me
PGADMIN_PORT=5050
